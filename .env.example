# NatureAide Environment Configuration Template
# Copy this file to .env.local and configure your local settings.
# DO NOT place actual production secrets in this file.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=natureaide_db
AUTH_SECRET=natureaide_dev_jwt_auth_secret_minimum_32_characters_long

# AI Model Configuration (Optional)
TOGETHER_API_KEY=
TOGETHER_MODEL_PRIMARY=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_MODEL_FALLBACK=deepseek-ai/DeepSeek-V4.1-Flash
TOGETHER_MODEL_FINAL=zai-org/GLM-5.3-Flash

# xAI Grok API Configuration (Optional)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7

# AutoDock Vina Docking Toolchain (Stage 3)
# Leave blank to automatically resolve from project root (.docking-venv and tools/vina)
VINA_BIN=
DOCKING_PYTHON=
DOCKING_ARTIFACT_DIR=
DOCKING_TIMEOUT_SECONDS=900
